{
  "name": "@jackdog668/vibeaudit",
  "version": "1.4.0",
  "description": "Security audit CLI for AI-generated codebases. Find the time bombs before they blow.",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "bin": {
    "vibeaudit": "./bin/vibe-audit.js",
    "vibeguard": "./bin/vibeguard.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/install-vibeguard.ps1",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js tests/rules/*.test.js",
    "lint": "eslint src/ bin/ tests/ scripts/",
    "audit:self": "node bin/vibe-audit.js . --trust-target-config",
    "ui": "node src/web/server.js",
    "ui:dev": "node --watch src/web/server.js",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "security",
    "audit",
    "vibe-coding",
    "ai-generated-code",
    "cli",
    "static-analysis",
    "devsecops",
    "ast"
  ],
  "author": "Digital Alchemy Academy <hello@digitalalchemy.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithdesi/vibeaudit.git"
  },
  "homepage": "https://digitalalchemy.dev/vibe-audit",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-loose": "^8.5.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
