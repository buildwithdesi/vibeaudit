{
  "name": "@jackdog668/vibeaudit",
  "version": "1.4.0",
  "description": "Security audit CLI for AI-generated codebases. Find the time bombs before they blow.",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "bin": {
    "vibeaudit": "./bin/vibe-audit.js",
    "vibeguard": "./bin/vibeguard.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/install-vibeguard.ps1",
    "docs/protection-pilot.md",
    "docs/protected-npm-install.md",
    "examples/protection-pilot/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js tests/rules/*.test.js",
    "test:pilot": "node --test tests/pilot.docker.js",
    "test:install": "node --test tests/protected-install.npm.js",
    "lint": "eslint src/ bin/ tests/ scripts/",
    "verify": "npm run bundle:check && npm run lint && npm test && npm run test:install",
    "scan:morning": "node scripts/run-morning-scan.js",
    "bundle:check": "node scripts/check-agent-bundle-baseline.js",
    "bundle:update": "node scripts/check-agent-bundle-baseline.js --write",
    "audit:self": "node bin/vibe-audit.js . --trust-target-config --skip-osv",
    "benchmark:agent": "node scripts/agent-benchmark.js",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "security",
    "audit",
    "vibe-coding",
    "ai-generated-code",
    "cli",
    "static-analysis",
    "devsecops",
    "ast"
  ],
  "author": "Digital Alchemy Academy <hello@digitalalchemy.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithdesi/vibeaudit.git"
  },
  "homepage": "https://digitalalchemy.dev/vibe-audit",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-loose": "^8.5.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
